---
interface Props { vimeoId?: string; poster: string; posterSet?: string; label: string; soonLabel: string; focus?: string; title: string }
const { vimeoId = '', poster, posterSet, label, soonLabel, focus = '50% 50%', title } = Astro.props;
---
<div class="player" data-vimeo={vimeoId}>
  {poster ? <img src={poster} srcset={posterSet} sizes="100vw" alt="" style={`object-position:${focus}`} fetchpriority="high" /> : <div class="blank"></div>}
  {vimeoId ? (
    <button type="button" class="play" aria-label={`${label}: ${title}`}>
      <span class="ring"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></svg></span>
      <span class="label"><b>{label}</b></span>
    </button>
  ) : (
    <p class="soon label"><b>{soonLabel}</b></p>
  )}
</div>
<style>
  .player { position: relative; aspect-ratio: 16 / 9; max-height: 100svh; width: 100%; background: #000; overflow: hidden; }
  .player img, .player .blank { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .player .blank { background: radial-gradient(120% 90% at 20% 0%, #24201b 0%, #0b0a09 65%); }
  .player::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(11,10,9,.9), rgba(11,10,9,0) 40%); pointer-events: none; }
  .player.playing::after { display: none; }
  .player :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 3; }
  .play { all: unset; cursor: pointer; position: absolute; z-index: 2; inset: 0; display: flex; flex-direction: column; gap: 16px; align-items: center; justify-content: center; }
  .play .ring { width: 92px; height: 92px; border-radius: 50%; border: 1px solid var(--ink); display: grid; place-items: center; backdrop-filter: blur(6px); background: rgba(11,10,9,.25); transition: transform .25s, background .25s, color .25s; padding-left: 4px; }
  .play:hover .ring { transform: scale(1.07); background: var(--ink); color: var(--bg); }
  .play:focus-visible .ring { outline: 2px solid var(--ink); outline-offset: 5px; }
  .soon { position: absolute; z-index: 2; right: var(--gut); bottom: clamp(16px, 3vw, 32px); margin: 0; border: 1px solid var(--line); padding: 8px 12px; background: rgba(11,10,9,.5); backdrop-filter: blur(6px); }
  @media (max-width: 700px) { .player { aspect-ratio: 4 / 3; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.player[data-vimeo]').forEach((p) => {
    const id = p.dataset.vimeo; const btn = p.querySelector('.play');
    if (!id || !btn) return;
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`;
      f.allow = 'autoplay; fullscreen; picture-in-picture'; f.allowFullscreen = true; f.title = btn.getAttribute('aria-label') || 'Video';
      p.appendChild(f); p.classList.add('playing'); btn.remove();
    });
  });
</script>
