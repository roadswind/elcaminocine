---
import Base from '../layouts/Base.astro';
import { films, ui, routes, filmPath, frameSrc, frameSet, mailto, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const list = films.filter((f) => f.watch && f.watch !== 'none');
const L = lang === 'es'
  ? { title: 'Sala', lede: 'La sala de proyección de EL CAMINO CINE. Instálala en tu teléfono o computador y mira nuestras películas cuando se estrenen.', now: 'En cartelera', soonBody: 'Esta película está en su recorrido de estreno. Cuando termine, podrás verla aquí.', page: 'Ficha de la película', installed: 'Se instala como una app: sin tienda, sin descargas pesadas.', ios: 'En iPhone: Compartir → “Añadir a pantalla de inicio”.' }
  : { title: 'Screening room', lede: 'EL CAMINO CINE’s screening room. Install it on your phone or computer and watch our films as they are released.', now: 'Now showing', soonBody: 'This film is on its premiere run. Once it is over, you will be able to watch it here.', page: 'Film page', installed: 'Installs like an app: no store, no heavy downloads.', ios: 'On iPhone: Share → “Add to Home Screen”.' };
---
<Base lang={lang} title={L.title} description={L.lede} alt={routes[lang === 'es' ? 'en' : 'es'].watch} current="watch" solidHead>
  <div class="wrap page-head">
    <h1>{L.title}</h1>
    <p class="lede">{L.lede}</p>
    <div class="inst">
      <button type="button" class="btn" id="install" hidden>{t.install} <span class="arr">↓</span></button>
      <p class="label" id="inst-note">{L.installed} <span id="ios" hidden>{L.ios}</span></p>
    </div>
  </div>
  <div class="wrap">
    <p class="label" style="margin-bottom:14px">{L.now} · {String(list.length).padStart(2, '0')}</p>
    {list.map((f) => (
      <article class="screen" id={f.slug}>
        <div class="stage" data-vimeo={f.watch === 'public' ? f.filmVimeoId : ''}>
          {f.frames > 0 && <img src={frameSrc(f.slug, 1, 1600)} srcset={frameSet(f.slug, 1)} sizes="100vw" alt="" style={`object-position:${f.focus}`} />}
          {f.watch === 'public' && f.filmVimeoId
            ? <button type="button" class="play" aria-label={`${t.watchFilm}: ${f.title}`}><span class="ring"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" fill="currentColor"/></svg></span></button>
            : <div class="soon"><p class="tag" data-status="estreno">{t.watchSoon}</p><p>{L.soonBody}</p></div>}
        </div>
        <div class="bar">
          <div><h2>{f.title}</h2><p class="label">{[t.format[f.format], f[lang].genre, f.runtime, f.year].filter(Boolean).join(' · ')}</p></div>
          <div class="acts">
            <a class="btn ghost" href={filmPath(lang, f.slug)}>{L.page}</a>
            {f.watch !== 'public' && mailto(`${f.title} — ${t.notify}`) && <a class="btn" href={mailto(`${f.title} — ${t.notify}`)}>{t.notify}</a>}
          </div>
        </div>
      </article>
    ))}
  </div>
</Base>
<style>
  .inst { display: flex; flex-wrap: wrap; gap: 14px 20px; align-items: center; margin-top: 26px; }
  .inst p { margin: 0; line-height: 1.7; }
  .screen { margin-bottom: clamp(32px, 5vw, 72px); scroll-margin-top: calc(var(--nav-h) + 16px); }
  .stage { position: relative; aspect-ratio: 16 / 9; background: #000; overflow: hidden; }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .stage :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 3; }
  .play { all: unset; cursor: pointer; position: absolute; inset: 0; display: grid; place-items: center; z-index: 2; }
  .play .ring { width: 92px; height: 92px; border-radius: 50%; border: 1px solid var(--ink); display: grid; place-items: center; padding-left: 4px; background: rgba(11,10,9,.3); transition: all .25s; }
  .play:hover .ring { background: var(--ink); color: var(--bg); transform: scale(1.07); }
  .play:focus-visible .ring { outline: 2px solid var(--ink); outline-offset: 5px; }
  .soon { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 14px; padding: 6%; }
  .soon p:last-child { max-width: 38ch; margin: 0; font-style: italic; font-size: clamp(18px, 2vw, 28px); line-height: 1.25; }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; padding-top: 18px; }
  .bar h2 { font-size: clamp(36px, 5vw, 80px); margin-bottom: 8px; }
  .acts { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 700px) { .stage { aspect-ratio: 4 / 3; } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.stage[data-vimeo]').forEach((s) => {
    const id = s.dataset.vimeo; const b = s.querySelector('.play'); if (!id || !b) return;
    b.addEventListener('click', () => { const f = document.createElement('iframe'); f.src = `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`; f.allow = 'autoplay; fullscreen; picture-in-picture'; f.allowFullscreen = true; f.title = b.getAttribute('aria-label') || 'Video'; s.appendChild(f); b.remove(); });
  });
  const btn = document.getElementById('install') as HTMLButtonElement; let deferred: any;
  window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); deferred = e; btn.hidden = false; });
  btn?.addEventListener('click', async () => { if (!deferred) return; deferred.prompt(); await deferred.userChoice; deferred = null; btn.hidden = true; });
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
  if (/iphone|ipad|ipod/i.test(navigator.userAgent) && !standalone) document.getElementById('ios')!.hidden = false;
  if (standalone) document.querySelector<HTMLElement>('.inst')!.hidden = true;
</script>
