---
import Base from '../layouts/Base.astro';
import team from '../data/team.json';
import { ui, routes, mailto, settings, frameSrc, frameSet, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props; const es = lang === 'es'; const t = ui[lang];
const manifesto = es ? team.manifestoEs : team.manifestoEn;
const L = es ? { title: 'Nosotros', man: 'Manifiesto', team: 'Equipo', desc: 'EL CAMINO CINE es una productora de cine fundada en Bogotá, Colombia.' } : { title: 'About', man: 'Manifesto', team: 'Team', desc: 'EL CAMINO CINE is a film production company founded in Bogotá, Colombia.' };
const mail = mailto(es ? 'Hola, EL CAMINO CINE' : 'Hello, EL CAMINO CINE');
const initials = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<Base lang={lang} title={L.title} description={L.desc} alt={routes[es ? 'en' : 'es'].about} current="about" solidHead>
  <div class="wrap page-head">
    <p class="label"><b>{L.man}</b></p>
    <div class="man">
      {manifesto.map((p, i) => <p class:list={[{ first: i === 0 }]}>{p}</p>)}
    </div>
  </div>
  <div class="band reveal"><img src={frameSrc('nancy-and-nancy', 2, 1600)} srcset={frameSet('nancy-and-nancy', 2)} sizes="100vw" alt="Nancy & Nancy" loading="lazy" /></div>
  <section class="wrap section">
    <h2 class="label">{L.team}</h2>
    {team.members.map((m) => (
      <article class="m reveal">
        <div class="ph">{m.photo ? <img src={m.photo} alt={m.name} loading="lazy" /> : <span aria-hidden="true">{initials(m.name)}</span>}</div>
        <div>
          <h3>{m.name}</h3>
          <p class="label"><b>{es ? m.roleEs : m.roleEn}</b></p>
          <p class="bio">{es ? m.bioEs : m.bioEn}</p>
        </div>
      </article>
    ))}
  </section>
  <section class="wrap end" id="contacto">
    <p class="label"><b>{t.contact}</b></p>
    <p class="c">{t.coffee}</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      {mail && <a class="btn" href={mail}>{settings.email} <span class="arr">→</span></a>}
      {settings.instagram && <a class="btn ghost" href={settings.instagram} rel="noopener">Instagram</a>}
      <a class="btn ghost" href={routes[lang].producers}>{t.producers}</a>
    </div>
  </section>
</Base>
<style>
  .man { margin-top: 22px; }
  .man p { font-style: italic; font-size: clamp(24px, 3vw, 50px); line-height: 1.16; max-width: 26ch; margin: 0 0 .7em; color: #cfc8bc; }
  .man p.first { font-family: var(--display); font-style: normal; text-transform: uppercase; font-size: clamp(60px, 11.5vw, 200px); line-height: .88; max-width: 13ch; color: var(--ink); margin-bottom: .35em; }
  .band { aspect-ratio: 2.39 / 1; overflow: hidden; } .band img { width: 100%; height: 100%; object-fit: cover; }
  .m { display: grid; grid-template-columns: minmax(200px, 360px) 1fr; gap: clamp(24px, 5vw, 80px); margin-top: 22px; border-top: 1px solid var(--line); padding-top: 28px; }
  .ph { aspect-ratio: 4 / 5; background: radial-gradient(120% 90% at 30% 0%, #26221d 0%, #100e0d 65%); display: grid; place-items: center; overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; }
  .ph span { font-family: var(--display); font-size: clamp(90px, 10vw, 160px); color: transparent; -webkit-text-stroke: 1px rgba(236,231,222,.3); }
  .m h3 { font-size: clamp(48px, 6vw, 100px); margin-bottom: 12px; }
  .bio { margin-top: 20px; max-width: 58ch; }
  .end { border-top: 1px solid var(--line); padding-top: clamp(32px, 5vw, 64px); }
  .c { font-family: var(--display); text-transform: uppercase; font-size: clamp(52px, 9.5vw, 170px); line-height: .88; max-width: 13ch; margin: 14px 0 28px; }
  @media (max-width: 760px) { .m { grid-template-columns: 1fr; } .ph { max-width: 280px; } }
</style>
