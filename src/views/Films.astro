---
import Base from '../layouts/Base.astro';
import FilmCard from '../components/FilmCard.astro';
import { films, ui, routes, type Lang } from '../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const title = lang === 'es' ? 'Películas y series' : 'Films and series';
const filters = [
  { g: 'all', v: 'all', label: t.all },
  { g: 'format', v: 'largometraje', label: t.formatPlural.largometraje },
  { g: 'format', v: 'cortometraje', label: t.formatPlural.cortometraje },
  { g: 'format', v: 'serie', label: t.formatPlural.serie },
  { g: 'kind', v: 'ficcion', label: t.kind.ficcion },
  { g: 'kind', v: 'documental', label: t.kind.documental },
];
---
<Base lang={lang} title={title} alt={routes[lang === 'es' ? 'en' : 'es'].films} current="films" solidHead>
  <div class="wrap page-head">
    <h1>{t.films}</h1>
    <div class="filters" role="group" aria-label={lang === 'es' ? 'Filtrar proyectos' : 'Filter projects'}>
      {filters.map((f, i) => <button type="button" data-g={f.g} data-v={f.v} aria-pressed={i === 0 ? 'true' : 'false'} class:list={[{ sep: f.v === 'ficcion' }]}>{f.label}</button>)}
      <span class="label count" aria-live="polite"></span>
    </div>
  </div>
  <div class="wrap grid">
    {films.map((f, i) => <FilmCard film={f} lang={lang} sizes="(max-width: 800px) 100vw, 50vw" eager={i < 2} />)}
    <p class="empty" hidden>{t.noResults}</p>
  </div>
</Base>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: clamp(22px, 3vw, 40px); }
  .filters button { all: unset; cursor: pointer; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; padding: 0 16px; min-height: 42px; display: inline-flex; align-items: center; border: 1px solid var(--line); color: var(--muted); transition: all .2s; }
  .filters button:hover { color: var(--ink); border-color: var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .filters button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .filters button.sep { margin-left: 14px; }
  .count { margin-left: auto; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(10px, 1.2vw, 18px); }
  .grid :global(.card[hidden]) { display: none; }
  .empty { grid-column: 1 / -1; font-style: italic; font-size: clamp(22px, 2.4vw, 34px); padding: 8vh 0; color: var(--muted); }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } .filters button.sep { margin-left: 0; } .count { width: 100%; margin: 6px 0 0; } }
</style>
<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
  const cards = [...document.querySelectorAll<HTMLElement>('.grid .card')];
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const count = document.querySelector<HTMLElement>('.count')!;
  const state: Record<string, string | null> = { format: null, kind: null };
  const apply = () => {
    let n = 0;
    cards.forEach((c) => { const ok = (!state.format || c.dataset.format === state.format) && (!state.kind || c.dataset.kind === state.kind); c.hidden = !ok; if (ok) n++; });
    empty.hidden = n > 0; count.textContent = String(n).padStart(2, '0') + ' / ' + String(cards.length).padStart(2, '0');
    btns.forEach((b) => { const g = b.dataset.g!; b.setAttribute('aria-pressed', String(g === 'all' ? !state.format && !state.kind : state[g] === b.dataset.v)); });
    const q = new URLSearchParams(); if (state.format) q.set('f', state.format); if (state.kind) q.set('k', state.kind);
    history.replaceState(null, '', q.toString() ? '?' + q : location.pathname);
  };
  btns.forEach((b) => b.addEventListener('click', () => {
    const g = b.dataset.g!, v = b.dataset.v!;
    if (g === 'all') { state.format = null; state.kind = null; } else state[g] = state[g] === v ? null : v;
    apply();
  }));
  const q = new URLSearchParams(location.search); state.format = q.get('f'); state.kind = q.get('k'); apply();
</script>
